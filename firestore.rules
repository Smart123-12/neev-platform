rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // NGOs can read/write their own org document
    match /ngos/{ngoId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == ngoId;
    }

    // Needs: any auth user can read; only NGOs can write
    match /needs/{needId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/ngos/$(request.auth.uid)).data != null;
      allow update, delete: if request.auth != null
        && resource.data.ngoId == request.auth.uid;
    }

    // Volunteers can read/write their own profile
    match /volunteers/{volunteerId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == volunteerId;
    }

    // Assignments: volunteers can create their own; NGOs can read all
    match /assignments/{assignmentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.volunteerId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.volunteerId == request.auth.uid;
    }
  }
}
